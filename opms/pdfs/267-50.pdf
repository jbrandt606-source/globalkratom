         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">pills</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A set pharmacy icons that include editable strokes or outlines using the EPS vector file. The icons include a pharmacy, pharmacist, pharmaceuticals, medicine, pills, prescriptions, prescription card, online ordering, pill bottle, prescription refill, child safety, family, mortar and pestle, syringe, vaccination, bandage, paying and other pharmacy related icons.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">appleuzr</rdf:li>
            </rdf:Alt>
